{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Margin (native)",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "dev:desktop"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "Build Margin",
      "type": "shell",
      "command": "pnpm",
      "args": ["run", "build"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
